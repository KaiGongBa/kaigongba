APP_NAME=开工吧
RUNTIME_ENVIRONMENT=production
DATABASE_URL=postgresql://transaction_app:__PASSWORD__@postgres.internal/kaigongba_transaction
DATABASE_STARTUP_MODE=validate
APP_SECRET=__SHARED_ACCESS_TOKEN_SECRET__
INTERNAL_SERVICE_SECRET=__INTERNAL_SERVICE_SECRET__
DEMO_SEED_ENABLED=false
MARKETPLACE_SEED_ENABLED=false
STAFFDECK_INTERNAL_BASE_URL=http://staffdeck.internal:8021
STAFFDECK_INTERNAL_TIMEOUT_SECONDS=5
TRANSACTION_OUTBOX_POLL_SECONDS=2
REDIS_URL=redis://:__PASSWORD__@redis.internal:6379/0
REDIS_KEY_PREFIX=kaigongba:transaction
ORDER_OBJECT_STORAGE_PROVIDER=s3
ORDER_OBJECT_STORAGE_BUCKET=kaigongba-order-files
ORDER_OBJECT_STORAGE_ENDPOINT_URL=https://object-storage.internal
ORDER_OBJECT_STORAGE_ACCESS_KEY=__ACCESS_KEY__
ORDER_OBJECT_STORAGE_SECRET_KEY=__SECRET_KEY__
ORDER_OBJECT_STORAGE_REGION=us-east-1
ORDER_OBJECT_STORAGE_SIGNED_URL_SECONDS=300
SKILL_PACKAGE_MAX_BYTES=20971520
SKILL_PACKAGE_MAX_FILES=200
SKILL_PACKAGE_MAX_UNCOMPRESSED_BYTES=104857600
HOSTED_SKILL_EXECUTION_ENABLED=false
HOSTED_SKILL_CONTAINER_RUNTIME=docker
# 正式启用时必须替换为 registry/image@sha256:... 固定镜像。
HOSTED_SKILL_PYTHON_IMAGE=registry.internal/kaigongba/skill-python@sha256:__DIGEST__
HOSTED_SKILL_NODE_IMAGE=registry.internal/kaigongba/skill-node@sha256:__DIGEST__
HOSTED_SKILL_TIMEOUT_SECONDS=30
HOSTED_SKILL_MEMORY_MB=256
HOSTED_SKILL_CPU_LIMIT=0.5
HOSTED_SKILL_PIDS_LIMIT=64
HOSTED_SKILL_TMPFS_MB=64
