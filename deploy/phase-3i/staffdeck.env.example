APP_NAME=开工吧
RUNTIME_ENVIRONMENT=production
DATABASE_URL=postgresql://staffdeck_app:__PASSWORD__@postgres.internal/kaigongba_staffdeck
DATABASE_STARTUP_MODE=validate
APP_SECRET=__SHARED_ACCESS_TOKEN_SECRET__
INTERNAL_SERVICE_SECRET=__INTERNAL_SERVICE_SECRET__
DEMO_SEED_ENABLED=false
MARKETPLACE_SEED_ENABLED=false
STAFFDECK_ROLE=api
IDENTITY_INTERNAL_BASE_URL=http://transaction-core.internal:8022
IDENTITY_INTERNAL_TIMEOUT_SECONDS=5
REDIS_URL=redis://:__PASSWORD__@redis.internal:6379/0
REDIS_KEY_PREFIX=kaigongba:staffdeck
GENERAL_SKILL_RUNTIME_AUTO_INSTALL=false
GENERAL_SKILL_NETWORK_INSTALL=false
