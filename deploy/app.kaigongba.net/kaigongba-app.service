[Unit]
Description=Kai Gong Ba application API
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=kgbapp
Group=kgbapp
WorkingDirectory=/opt/kaigongba-app/current/backend
EnvironmentFile=/opt/kaigongba-app/shared/app.env
Environment=HOME=/opt/kaigongba-app/shared
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/kaigongba-app/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8020 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
TimeoutStartSec=90
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/kaigongba-app/shared

[Install]
WantedBy=multi-user.target
