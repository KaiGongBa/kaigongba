APP_NAME=开工吧
RUNTIME_ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://kgbapp@/kgbapp?host=/var/run/postgresql
DATABASE_STARTUP_MODE=validate
APP_SECRET=__APP_SECRET__
INTERNAL_SERVICE_SECRET=__INTERNAL_SERVICE_SECRET__
REDIS_URL=redis://kaigongba-app:__REDIS_PASSWORD__@127.0.0.1:6379/0
REDIS_KEY_PREFIX=kaigongba:app
REDIS_SOCKET_TIMEOUT_SECONDS=2
REDIS_MAX_CONNECTIONS=50
DEMO_SEED_ENABLED=false
MARKETPLACE_SEED_ENABLED=false
DEMO_PAYMENT_CONFIRMATION_CODE=__DEMO_PAYMENT_CODE__
ORDER_OBJECT_STORAGE_PROVIDER=local
ORDER_OBJECT_STORAGE_DIR=/opt/kaigongba-app/shared/order-objects
# OSS 生产切换值（阿里云 OSS 只接受 virtual-hosted 寻址）：
# ORDER_OBJECT_STORAGE_PROVIDER=s3
# ORDER_OBJECT_STORAGE_ENDPOINT_URL=https://s3.oss-cn-beijing.aliyuncs.com
# ORDER_OBJECT_STORAGE_BUCKET=kaigongba-order-files-prod
# ORDER_OBJECT_STORAGE_REGION=cn-beijing
# ORDER_OBJECT_STORAGE_ADDRESSING_STYLE=virtual
# 只使用最小权限 RAM 用户的 AccessKey，禁止使用主账号 AccessKey。
# ORDER_OBJECT_STORAGE_ACCESS_KEY=__OSS_ACCESS_KEY_ID__
# ORDER_OBJECT_STORAGE_SECRET_KEY=__OSS_ACCESS_KEY_SECRET__
# ORDER_OBJECT_STORAGE_SESSION_TOKEN=
ORDER_OBJECT_STORAGE_SIGNED_URL_SECONDS=300
ORDER_FILE_MAX_BYTES=52428800
SKILL_PACKAGE_MAX_BYTES=20971520
SKILL_PACKAGE_MAX_FILES=200
SKILL_PACKAGE_MAX_UNCOMPRESSED_BYTES=104857600
# 当前单机版本保持关闭，第三方包默认由外部 Agent 执行。
HOSTED_SKILL_EXECUTION_ENABLED=false
TOOL_BASE_URL=https://app.kaigongba.net
CORS_ORIGINS=https://app.kaigongba.net
STAFFDECK_ROLE=api
GENERAL_SKILL_RUNTIME_AUTO_INSTALL=false
GENERAL_SKILL_NETWORK_INSTALL=false
CHANNEL_DINGTALK_REACTION_ENABLED=false
