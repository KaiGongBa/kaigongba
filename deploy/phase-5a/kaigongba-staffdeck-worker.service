[Unit]
Description=Kai Gong Ba StaffDeck scheduled task worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kgbapp
Group=kgbapp
WorkingDirectory=/opt/kaigongba-app/current/backend
EnvironmentFile=/opt/kaigongba-app/shared/staffdeck.env
Environment=HOME=/opt/kaigongba-app/shared
Environment=PYTHONUNBUFFERED=1
Environment=STAFFDECK_ROLE=worker
ExecStart=/opt/kaigongba-app/venv/bin/python -m app.scheduled_tasks.worker --poll-seconds 5
Restart=on-failure
RestartSec=5
TimeoutStartSec=90
TimeoutStopSec=90
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/kaigongba-app/shared

[Install]
WantedBy=multi-user.target
