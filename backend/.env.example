APP_NAME="Kai Gong Ba"
RUNTIME_ENVIRONMENT="development"
DATABASE_URL="sqlite:///./skill_agent_loop.db"
DATABASE_STARTUP_MODE="legacy"
APP_SECRET="change-me-in-development"
# 正式环境用于交易核心与 StaffDeck 内网 API，不得与 APP_SECRET 共用。
INTERNAL_SERVICE_SECRET=""
# StaffDeck 独立进程填写交易核心内网地址；交易核心和本地合并模式留空。
IDENTITY_INTERNAL_BASE_URL=""
IDENTITY_INTERNAL_TIMEOUT_SECONDS="5"
DEMO_SEED_ENABLED=true
# 仅开发环境开启；生产环境必须保持 false，并通过真实业务流程写入数据。
MARKETPLACE_SEED_ENABLED=true
# 演示支付专用确认码；不是真实支付凭证，生产环境应关闭演示支付入口。
DEMO_PAYMENT_CONFIRMATION_CODE="DEMO-PAY"
ORDER_OBJECT_STORAGE_PROVIDER="local"
ORDER_OBJECT_STORAGE_DIR="./.data/order-objects"
ORDER_OBJECT_STORAGE_BUCKET="kaigongba-order-files"
ORDER_OBJECT_STORAGE_ENDPOINT_URL=""
ORDER_OBJECT_STORAGE_ACCESS_KEY=""
ORDER_OBJECT_STORAGE_SECRET_KEY=""
ORDER_OBJECT_STORAGE_REGION="us-east-1"
ORDER_OBJECT_STORAGE_SIGNED_URL_SECONDS=300
ORDER_FILE_MAX_BYTES=52428800
SKILL_PACKAGE_MAX_BYTES=20971520
SKILL_PACKAGE_MAX_FILES=200
SKILL_PACKAGE_MAX_UNCOMPRESSED_BYTES=104857600
# 默认关闭。只有独立容器 Worker、固定 digest 镜像和运行节点策略均完成后才可打开。
HOSTED_SKILL_EXECUTION_ENABLED=false
HOSTED_SKILL_CONTAINER_RUNTIME=docker
HOSTED_SKILL_PYTHON_IMAGE=python:3.12-alpine
HOSTED_SKILL_NODE_IMAGE=node:22-alpine
HOSTED_SKILL_TIMEOUT_SECONDS=30
HOSTED_SKILL_MEMORY_MB=256
HOSTED_SKILL_CPU_LIMIT=0.5
HOSTED_SKILL_PIDS_LIMIT=64
HOSTED_SKILL_TMPFS_MB=64
DEMO_MODEL_BASE_URL="http://localhost:52010/v1"
DEMO_MODEL_NAME="qwen3.6-27b"
DEMO_MODEL_API_KEY=""
MODEL_THINKING_MODE=""
MODEL_THINKING_MODELS=""
# 首次使用平台计费模型时创建当月租户额度；0 表示不自动发放。
AI_DEFAULT_MONTHLY_CREDITS="10000"
AI_DEFAULT_QUOTA_HARD_LIMIT="false"
AI_QUOTA_WARNING_THRESHOLD_PERCENT="80"
TOOL_TIMEOUT_SECONDS="8"
TOOL_BASE_URL="http://localhost:5173"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
GENERAL_SKILL_RUNTIME_PYTHON=""
GENERAL_SKILL_RUNTIME_VENV=""
GENERAL_SKILL_RUNTIME_PACKAGES="requests,httpx"
GENERAL_SKILL_RUNTIME_AUTO_INSTALL="true"
CHANNEL_SECRET=""
# all 仅用于本地兼容单体；正式拆分部署的 API 使用 api，渠道进程使用 connector。
STAFFDECK_ROLE="all"
# 交易核心独立部署时填写 StaffDeck API 内网地址；留空仅用于本地合并模式。
STAFFDECK_INTERNAL_BASE_URL=""
STAFFDECK_INTERNAL_TIMEOUT_SECONDS="5"
TRANSACTION_OUTBOX_POLL_SECONDS="2"
REDIS_URL=""
REDIS_KEY_PREFIX="kaigongba"
REDIS_SOCKET_TIMEOUT_SECONDS="2"
WECHAT_ILINK_BASE_URL="https://ilinkai.weixin.qq.com"
CHANNEL_DELIVERY_POLL_SECONDS="1.0"
CHANNEL_DELIVERY_MAX_ATTEMPTS="8"
