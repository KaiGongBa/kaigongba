{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "requirement-field-map.schema.json",
  "title": "Assistant Requirement Draft Field Map v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "draft_type", "target_model", "fields"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "draft_type": {"const": "requirement"},
    "target_model": {"const": "app.transaction.schemas.RequirementWrite"},
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "draft_field", "target_field", "disposition", "source_policy", "hard_fact",
          "required_for_preview", "required_for_save", "required_for_publish"
        ],
        "properties": {
          "draft_field": {"type": "string", "minLength": 1},
          "target_field": {"type": ["string", "null"]},
          "disposition": {"enum": ["mapped", "server_derived", "assistant_only", "blocking_unmapped"]},
          "source_policy": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["user_message", "user_choice", "user_edit", "attachment_extraction", "existing_record", "ai_expansion", "system_default"]}
          },
          "hard_fact": {"type": "boolean"},
          "confirmation": {"enum": ["required", "required_if_present", "not_required"]},
          "required_for_preview": {"type": "boolean"},
          "required_for_save": {"type": "boolean"},
          "required_for_publish": {"type": "boolean"},
          "transform": {"type": "string"},
          "validation": {"type": "string"},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
