{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capability-registry.schema.json",
  "title": "Platform Assistant Business Capability Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "capabilities"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
          "required": [
            "capability_id", "version", "display_name", "risk_level", "intents",
            "required_permissions", "allowed_projections", "allowed_tools",
            "forbidden_actions", "supported_route_ids", "target_route_id",
            "execution_service"
        ],
        "properties": {
          "capability_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]+$"},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "display_name": {"type": "string", "minLength": 1, "maxLength": 120},
          "risk_level": {"enum": ["R0", "R1", "R2", "R3", "R4"]},
          "intents": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "required_permissions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "allowed_projections": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]+$"}},
          "allowed_tools": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]+$"}
          },
          "forbidden_actions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]+$"}
          },
          "supported_route_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "target_route_id": {"type": "string", "minLength": 1},
          "execution_service": {"const": "platform_assistant"},
          "minimum_generation_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "fallback_strategy": {"enum": ["fixed_questions", "manual_only", "read_only"]}
        }
      }
    }
  }
}
